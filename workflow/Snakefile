default_config = {
    'log_level': 'info',
    'seed': [1],
}

config = {**default_config, **config}

include: "rules/data.smk"
include: "rules/msas_and_templates.smk"
include: "rules/alphafold2.smk"
include: "rules/alphafold3.smk"
include: "rules/boltz.smk"
include: "rules/chai.smk"
