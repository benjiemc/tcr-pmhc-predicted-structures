import csv
import os

envvars:
    "ALPHAFOLD_DATA_DIR",
    "TCRMODEL2_ALPHAFOLD_DATA_DIR",
    "ALPHAFOLD3_WEIGHTS_DIR"

rule lint:
    shell:
        """
        ruff check
        ruff format --check
        """

rule test:
    shell: "pytest --cov=src tests"

rule sample_sequences:
    input: "data/raw/sequences.csv"
    output: "data/interim/sequences_sample.csv"
    shell:
        """
        python -m tcr_pmhc_predicted_structures.apps.sample_sequences \
            --log-level info \
            --seed 123 \
            --sample-size 20 \
            --generate-background \
            -o {output} \
            {input}
        """

def _get_json_names(path: str) -> list[str]:
    if not os.path.exists(path):
        print(path, 'does not exist!')
        return []

    with open(path, 'r') as fh:
        reader = csv.DictReader(fh)

        return [f"data/interim/sequences-af3/{entry['id']}.json" for entry in reader]

rule create_af3_jsons:
    input:
        sequences="data/interim/sequences_sample.csv",
        mhc_sequences=expand("data/external/hla_sequences/{mhc}.json", mhc=[
            'h2_d',
            'h2_k',
            'h2_l',
            'hla_a',
            'hla_b',
            'hla_c',
            'hla_e',
            'hla_f',
            'hla_g',
        ])
    output: _get_json_names("data/interim/sequences_sample.csv")
    shell:
        """
        out_dir_name=$(dirname {output[0]})

        python -m tcr_pmhc_predicted_structures.apps.create_af3_json \
            --log-level info \
            --mhc-sequences {input.mhc_sequences} \
            -o $out_dir_name \
            {input.sequences}
        """

rule run_alphafold:
    input: "data/interim/sequences-af3/{name}.json"
    output: directory("data/interim/structures-af3/{name}")
    params:
        alphafold_data_dir=os.environ['ALPHAFOLD_DATA_DIR'],
        alphafold3_weights_dir=os.environ['ALPHAFOLD3_WEIGHTS_DIR']
    shell:
        """
        input_file_name="$(basename {input})"
        input_dir_abs="$(pwd)/$(dirname {input})"
        output_dir_abs="$(pwd)/$(dirname {output})"

        mkdir -p $output_dir_abs

        docker run -it \
            --volume $output_dir_abs:/tmp/af_output \
            --entrypoint bash \
            alphafold3 \
            -c "chown -R $(id -u):$(id -g) /tmp/af_output"


        docker run -it \
            --user $(id -u):$(id -g) \
            --volume $input_dir_abs:/tmp/af_input \
            --volume $output_dir_abs:/tmp/af_output \
            --volume {params.alphafold3_weights_dir}:/models \
            --volume {params.alphafold_data_dir}:/public_databases \
            --gpus all \
            alphafold3 \
            python run_alphafold.py \
                --json_path=/tmp/af_input/$input_file_name \
                --model_dir=/models \
                --output_dir=/tmp/af_output
        """

def _get_af3_names(path: str) -> list[str]:
    if not os.path.exists(path):
        print(path, 'does not exist!')
        return []

    with open(path, 'r') as fh:
        return [f"data/interim/structures-af3/{entry['id']}" for entry in csv.DictReader(fh)]

rule create_af3_structures:
    input: _get_af3_names("data/interim/sequences_sample.csv")

rule create_distance_restraints:
    input:
        "data/raw/structures_summary.csv",
        "data/raw/structures"

    output: "data/processed/tcr_pmhc_distance_restaints.csv"
    shell:
        """
        jupyter nbconvert --to notebook --execute --inplace notebooks/measure_constraint_distances.ipynb
        """

def _get_chai_names(path: str) -> list[str]:
    with open(path, 'r') as fh:
        reader = csv.DictReader(fh)

        return [
            f"data/interim/sequences-and-restraints-chain/{entry['id']}{extension}"
            for entry in reader for extension in ('.fasta', '_restraints.csv')
        ]

rule create_chai_sequences_and_restraints:
    input:
        sequences="data/interim/sequences_sample.csv",
        restraints="data/processed/tcr_pmhc_distance_restaints.csv",
        mhc_sequences=expand("data/external/hla_sequences/{mhc}.json", mhc=[
            'h2_d',
            'h2_k',
            'h2_l',
            'hla_a',
            'hla_b',
            'hla_c',
            'hla_e',
            'hla_f',
            'hla_g',
        ])
    output: _get_chai_names('data/interim/sequences_sample.csv')
    shell:
        """
        python -m tcr_pmhc_predicted_structures.apps.convert_to_input \
            --log-level info \
            --format chai \
            --mhc-sequences {input.mhc_sequences} \
            --chai-restraints {input.restraints} \
            -o $(dirname {output[0]}) \
            {input.sequences}
        """

rule predict_tcr_structures_using_tcrmodel2:
    input: "data/interim/sampled_vdjdb_norm.csv"
    output: directory("data/interim/tcrmodel2_output/tcrs")
    script: "scripts/predict_tcr_structures.py"

